# Streamlit Cloud 배포 시 이 내용을 secrets에 입력하세요.
# (이 파일 자체는 GitHub에 올려도 안전합니다 — 실제 값이 없으므로)
# 실제 secrets.toml은 .gitignore에 포함되어 GitHub에 올라가지 않습니다.

kakao_api_key       = "여기에 카카오 API 키 입력"
google_client_id    = "여기에 Google 클라이언트 ID 입력"
google_client_secret = "여기에 Google 클라이언트 보안 비밀 입력"
redirect_uri        = "https://여기에-배포된-앱-주소.streamlit.app"
